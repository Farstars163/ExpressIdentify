<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA">

    <TextView
        android:id="@+id/title_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:text="快捷出库身份码"
        android:textColor="#1C1F24"
        android:textSize="26sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/accent_bar"
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_accent_bar"
        app:layout_constraintStart_toStartOf="@+id/title_main"
        app:layout_constraintEnd_toEndOf="@+id/title_main"
        app:layout_constraintTop_toBottomOf="@+id/title_main" />

    <TextView
        android:id="@+id/subtitle_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="拼多多 · 淘宝 取件身份码一键直达"
        android:textColor="#8A929B"
        android:textSize="14sp"
        android:letterSpacing="0.04"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/accent_bar" />

    <LinearLayout
        android:id="@+id/cards_container"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.60">

        <!-- 身份码功能卡片：拼多多 -->
        <LinearLayout
            android:id="@+id/btn_pdd"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginHorizontal="20dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_card_pdd"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="拼多多  ›"
                android:textColor="#1C1F24"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="拼多多直达 · 多多取件身份码"
                android:textColor="#687078"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 身份码功能卡片：淘宝 -->
        <LinearLayout
            android:id="@+id/btn_taobao"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_card_taobao"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="淘宝  ›"
                android:textColor="#1C1F24"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="淘宝直达 · 淘宝·菜鸟取件身份码"
                android:textColor="#687078"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
